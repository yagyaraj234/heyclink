{
  "name": "voice-for-india",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "test": "node --env-file-if-exists=.env.test --test-global-setup=src/actions/drop-old-schemas.ts --test",
    "test:live": "LIVE=1 node --env-file-if-exists=.env --test",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test",
    "regress": "node scripts/regress.ts"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@duckdb/node-api": "2.0.0-r.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
