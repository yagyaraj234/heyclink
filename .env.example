OPENAI_API_KEY=
SARVAM_API_KEY=
PORT=3000

# Postgres. Neon: use the pooled connection string (host has -pooler), sslmode=require.
DATABASE_URL=
# Optional: connections per instance (default 5). Keep instances x this under the Neon plan limit.
PG_POOL_MAX=
# Tests only, in .env.test (gitignored). Each store gets a throwaway schema here; never point it at prod.
# TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres

# Owner-authorized Instamart cart review. Empty origin keeps the local cart and store links.
INSTAMART_PUBLIC_ORIGIN=
INSTAMART_CLIENT_ID=
INSTAMART_STAGING=1

# Optional Expo server access token for projects with push security enabled.
EXPO_ACCESS_TOKEN=
